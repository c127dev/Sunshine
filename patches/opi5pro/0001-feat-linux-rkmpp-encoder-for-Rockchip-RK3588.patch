diff --git a/src/platform/linux/rkmpp.cpp b/src/platform/linux/rkmpp.cpp
new file mode 100644
index 00000000..14bc90d6
--- /dev/null
+++ b/src/platform/linux/rkmpp.cpp
@@ -0,0 +1,418 @@
+/**
+ * @file src/platform/linux/rkmpp.cpp
+ * @brief Rockchip MPP (VEPU) hardware encode device.
+ *
+ * Pipeline: captured RGB dmabuf --> h264/hevc_rkmpp as AV_PIX_FMT_DRM_PRIME.
+ * The VEPU does the RGB->YUV conversion in hardware, so the captured buffer is
+ * imported into the encoder directly (true zero-copy, no RGA involved — the
+ * BSP RGA character device /dev/rga does not exist on mainline kernels).
+ *
+ * The VEPU cannot scale. When the stream resolution differs from the captured
+ * display, the GPU bridges the gap: the source dmabuf is imported into EGL and
+ * blitted (scaled) into a linear XRGB8888 GBM buffer of the stream size, which
+ * is then fed to the encoder the same way.
+ */
+
+// standard includes
+#include <cerrno>
+#include <cstring>
+#include <drm_fourcc.h>
+#include <fcntl.h>
+#include <gbm.h>
+#include <linux/dma-buf.h>
+#include <poll.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+extern "C" {
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_drm.h>
+#include <libavutil/pixdesc.h>
+}
+
+// local includes
+#include "rkmpp.h"
+#include "src/logging.h"
+#include "src/platform/linux/graphics.h"
+#include "src/video.h"
+
+using namespace std::literals;
+
+namespace rkmpp {
+
+  namespace {
+    void free_drm_desc(void *, uint8_t *data) {
+      auto desc = (AVDRMFrameDescriptor *) data;
+      if (desc->objects[0].fd >= 0) {
+        close(desc->objects[0].fd);
+      }
+      av_free(desc);
+    }
+  }  // namespace
+
+  class rkmpp_t: public platf::avcodec_encode_device_t {
+  public:
+    int init(int in_width, int in_height) {
+      // Must be non-null: video.cpp routes null-data devices to the software
+      // (swscale) path. The RKMPP hwdevice itself is created by
+      // rkmpp_init_avcodec_hardware_input_buffer in video.cpp, which never
+      // dereferences this pointer.
+      this->data = this;
+      width = in_width;
+      height = in_height;
+      return 0;
+    }
+
+    int set_frame(AVFrame *frame, AVBufferRef *hw_frames_ctx) override {
+      this->hwframe.reset(frame);
+      this->frame = frame;
+
+      // Allocate one BGR0 frame from the encoder's DRM_PRIME pool. It backs
+      // dummy images (probe/idle frames that carry no capture dmabuf).
+      dummy_frame.reset(av_frame_alloc());
+      if (!dummy_frame || av_hwframe_get_buffer(hw_frames_ctx, dummy_frame.get(), 0)) {
+        BOOST_LOG(error) << "rkmpp: couldn't allocate a dummy hwframe buffer"sv;
+        return -1;
+      }
+      return 0;
+    }
+
+    void apply_colorspace() override {
+      // Nothing to do: video.cpp sets colorspace/range on the AVCodecContext
+      // and rkmppenc forwards them to the VEPU's RGB->YUV converter per frame.
+    }
+
+    int convert(platf::img_t &img) override {
+      auto descriptor = dynamic_cast<egl::img_descriptor_t *>(&img);
+      if (!descriptor) {
+        BOOST_LOG(error) << "rkmpp: capture image is not a dmabuf descriptor"sv;
+        return -1;
+      }
+
+      if (descriptor->sequence == 0) {
+        // Dummy image (no dmabuf attached) — encode a black frame.
+        return attach_dummy();
+      }
+
+      auto &sd = descriptor->sd;
+
+      if (sd.width != frame->width || sd.height != frame->height) {
+        // The VEPU cannot scale — blit through the GPU into a stream-sized buffer.
+        return scale_convert(sd);
+      }
+
+      if (sd.modifier != DRM_FORMAT_MOD_LINEAR && sd.modifier != DRM_FORMAT_MOD_INVALID) {
+        log_once_unsupported_modifier(sd.modifier);
+        return -1;
+      }
+
+      switch (sd.fourcc) {
+        case DRM_FORMAT_XRGB8888:
+        case DRM_FORMAT_ARGB8888:
+          // Matches the BGR0/BGRA sw formats the encoder was opened with;
+          // the VEPU ignores the alpha channel.
+          break;
+        default:
+          BOOST_LOG(error) << "rkmpp: unsupported source fourcc: "sv << util::hex(sd.fourcc).to_string_view();
+          return -1;
+      }
+
+      auto fd = dup(sd.fds[0]);
+      if (fd < 0) {
+        BOOST_LOG(error) << "rkmpp: couldn't dup capture dmabuf: "sv << strerror(errno);
+        return -1;
+      }
+
+      // Implicit sync: the compositor's copy into this buffer is asynchronous
+      // GPU work tracked by dma-buf fences. The VEPU does not wait on those
+      // fences, so wait here (POLLIN = exclusive/write fence signaled) or the
+      // encoder reads half-written frames under GPU load (black patches).
+      pollfd pfd {fd, POLLIN, 0};
+      if (poll(&pfd, 1, 100) < 0) {
+        BOOST_LOG(warning) << "rkmpp: dmabuf fence wait failed: "sv << strerror(errno);
+      }
+
+      auto size = lseek(fd, 0, SEEK_END);
+      if (size < 0) {
+        BOOST_LOG(error) << "rkmpp: couldn't size capture dmabuf: "sv << strerror(errno);
+        close(fd);
+        return -1;
+      }
+
+      auto desc = (AVDRMFrameDescriptor *) av_mallocz(sizeof(AVDRMFrameDescriptor));
+      if (!desc) {
+        close(fd);
+        return -1;
+      }
+
+      desc->nb_objects = 1;
+      desc->objects[0].fd = fd;
+      desc->objects[0].size = (size_t) size;
+      desc->objects[0].format_modifier = DRM_FORMAT_MOD_LINEAR;
+
+      desc->nb_layers = 1;
+      auto &layer = desc->layers[0];
+      layer.format = sd.fourcc;
+      layer.nb_planes = 1;
+      layer.planes[0].object_index = 0;
+      layer.planes[0].offset = sd.offsets[0];
+      layer.planes[0].pitch = sd.pitches[0];
+
+      auto buf = av_buffer_create((uint8_t *) desc, sizeof(*desc), free_drm_desc, nullptr, 0);
+      if (!buf) {
+        free_drm_desc(nullptr, (uint8_t *) desc);
+        return -1;
+      }
+
+      av_buffer_unref(&frame->buf[0]);
+      frame->buf[0] = buf;
+      frame->data[0] = (uint8_t *) desc;
+      return 0;
+    }
+
+  private:
+    struct scale_slot_t {
+      gbm_bo *bo = nullptr;
+      egl::rgb_t rgb;  // EGLImage + GL texture bound to the slot's dmabuf
+      AVBufferRef *ref = nullptr;  // base ref on the slot's AVDRMFrameDescriptor
+    };
+
+    /**
+     * @brief Lazy-init the GPU scaler: EGL on a render node + a ring of
+     * stream-sized linear XRGB8888 GBM buffers the blit lands in.
+     */
+    int init_scaler() {
+      for (auto node : {"/dev/dri/renderD128", "/dev/dri/renderD129", "/dev/dri/renderD130"}) {
+        render_fd.el = open(node, O_RDWR | O_CLOEXEC);
+        if (render_fd.el >= 0) {
+          break;
+        }
+      }
+      if (render_fd.el < 0) {
+        BOOST_LOG(error) << "rkmpp: scaler: couldn't open a DRM render node"sv;
+        return -1;
+      }
+
+      gbm::init();
+      if (!gbm::create_device) {
+        BOOST_LOG(error) << "rkmpp: scaler: libgbm not available"sv;
+        return -1;
+      }
+
+      gbm_dev.reset(gbm::create_device(render_fd.el));
+      if (!gbm_dev) {
+        BOOST_LOG(error) << "rkmpp: scaler: couldn't create GBM device"sv;
+        return -1;
+      }
+
+      egl_display = egl::make_display(gbm_dev.get());
+      if (!egl_display) {
+        return -1;
+      }
+
+      auto ctx_opt = egl::make_ctx(egl_display.get());
+      if (!ctx_opt) {
+        return -1;
+      }
+      egl_ctx = std::move(*ctx_opt);
+
+      fbos = gl::frame_buf_t::make(2);
+
+      // graphics.h wraps libgbm behind an opaque gbm::device; the direct libgbm
+      // calls below need the real gbm_device pointer.
+      auto gbm_raw = reinterpret_cast<struct gbm_device *>(gbm_dev.get());
+
+      for (auto &slot : slots) {
+        slot.bo = gbm_bo_create(gbm_raw, frame->width, frame->height, GBM_FORMAT_XRGB8888, GBM_BO_USE_RENDERING | GBM_BO_USE_LINEAR);
+        if (!slot.bo) {
+          BOOST_LOG(error) << "rkmpp: scaler: couldn't create a GBM buffer"sv;
+          return -1;
+        }
+
+        auto fd = gbm_bo_get_fd(slot.bo);
+        if (fd < 0) {
+          BOOST_LOG(error) << "rkmpp: scaler: couldn't export GBM buffer"sv;
+          return -1;
+        }
+
+        egl::surface_descriptor_t dst_sd {};
+        dst_sd.width = frame->width;
+        dst_sd.height = frame->height;
+        dst_sd.fds[0] = fd;
+        dst_sd.fds[1] = dst_sd.fds[2] = dst_sd.fds[3] = -1;
+        dst_sd.fourcc = DRM_FORMAT_XRGB8888;
+        dst_sd.modifier = DRM_FORMAT_MOD_LINEAR;
+        dst_sd.pitches[0] = gbm_bo_get_stride(slot.bo);
+        dst_sd.offsets[0] = 0;
+
+        auto rgb_opt = egl::import_source(egl_display.get(), dst_sd);
+        if (!rgb_opt) {
+          BOOST_LOG(error) << "rkmpp: scaler: couldn't import target buffer into EGL"sv;
+          close(fd);
+          return -1;
+        }
+        slot.rgb = std::move(*rgb_opt);
+
+        auto size = lseek(fd, 0, SEEK_END);
+        if (size < 0) {
+          close(fd);
+          return -1;
+        }
+
+        auto desc = (AVDRMFrameDescriptor *) av_mallocz(sizeof(AVDRMFrameDescriptor));
+        if (!desc) {
+          close(fd);
+          return -1;
+        }
+        desc->nb_objects = 1;
+        desc->objects[0].fd = fd;  // owned by the descriptor, closed by free_drm_desc
+        desc->objects[0].size = (size_t) size;
+        desc->objects[0].format_modifier = DRM_FORMAT_MOD_LINEAR;
+        desc->nb_layers = 1;
+        desc->layers[0].format = DRM_FORMAT_XRGB8888;
+        desc->layers[0].nb_planes = 1;
+        desc->layers[0].planes[0].object_index = 0;
+        desc->layers[0].planes[0].offset = 0;
+        desc->layers[0].planes[0].pitch = dst_sd.pitches[0];
+
+        slot.ref = av_buffer_create((uint8_t *) desc, sizeof(*desc), free_drm_desc, nullptr, 0);
+        if (!slot.ref) {
+          free_drm_desc(nullptr, (uint8_t *) desc);
+          return -1;
+        }
+      }
+
+      BOOST_LOG(info) << "rkmpp: scaling "sv << width << 'x' << height
+                      << " -> "sv << frame->width << 'x' << frame->height << " via GPU blit"sv;
+      return 0;
+    }
+
+    /**
+     * @brief GPU-scale the captured dmabuf into a stream-sized buffer, then
+     * hand that buffer to the encoder.
+     */
+    int scale_convert(const egl::surface_descriptor_t &sd) {
+      if (scaler_state == 0) {
+        scaler_state = init_scaler() ? -1 : 1;
+      }
+      if (scaler_state < 0) {
+        return -1;
+      }
+
+      auto src = egl::import_source(egl_display.get(), sd);
+      if (!src) {
+        return -1;
+      }
+
+      auto &slot = slots[next_slot];
+      next_slot = (next_slot + 1) % slots.size();
+
+      gl::ctx.BindFramebuffer(GL_READ_FRAMEBUFFER, fbos[0]);
+      gl::ctx.FramebufferTexture(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, (*src)->tex[0], 0);
+      gl::ctx.BindFramebuffer(GL_DRAW_FRAMEBUFFER, fbos[1]);
+      gl::ctx.FramebufferTexture(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, slot.rgb->tex[0], 0);
+      gl::ctx.BlitFramebuffer(0, 0, sd.width, sd.height, 0, 0, frame->width, frame->height, GL_COLOR_BUFFER_BIT, GL_LINEAR);
+      gl::ctx.BindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+      gl::ctx.BindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+      gl::ctx.Finish();
+      gl_drain_errors;
+
+      auto buf = av_buffer_ref(slot.ref);
+      if (!buf) {
+        return -1;
+      }
+      av_buffer_unref(&frame->buf[0]);
+      frame->buf[0] = buf;
+      frame->data[0] = slot.ref->data;
+      return 0;
+    }
+
+    /**
+     * @brief Point the encoder frame at the pool-allocated black frame.
+     *
+     * Used for probe/idle images which carry no capture dmabuf.
+     */
+    int attach_dummy() {
+      if (!dummy_filled) {
+        auto desc = (AVDRMFrameDescriptor *) dummy_frame->data[0];
+        auto fd = desc->objects[0].fd;
+        auto size = desc->objects[0].size;
+
+        dma_buf_sync sync {DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE};
+        ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+
+        auto map = mmap(nullptr, size, PROT_WRITE, MAP_SHARED, fd, 0);
+        if (map == MAP_FAILED) {
+          BOOST_LOG(error) << "rkmpp: couldn't mmap dummy dmabuf: "sv << strerror(errno);
+          return -1;
+        }
+        memset(map, 0, size);  // zeroed BGR0 == black
+        munmap(map, size);
+
+        sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE;
+        ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+
+        dummy_filled = true;
+      }
+
+      auto buf = av_buffer_ref(dummy_frame->buf[0]);
+      if (!buf) {
+        return -1;
+      }
+      av_buffer_unref(&frame->buf[0]);
+      frame->buf[0] = buf;
+      frame->data[0] = dummy_frame->data[0];
+      return 0;
+    }
+
+    void log_once_unsupported_modifier(std::uint64_t modifier) {
+      if (!modifier_logged) {
+        BOOST_LOG(error) << "rkmpp: captured buffer has non-linear modifier "sv
+                         << util::hex(modifier).to_string_view()
+                         << " — the encoder only imports linear RGB (AFBC capture unsupported)"sv;
+        modifier_logged = true;
+      }
+    }
+
+    // Keep the encoder's frame alive for the lifetime of the device.
+    frame_t hwframe;
+    frame_t dummy_frame;
+
+    int width = 0;
+    int height = 0;
+    bool dummy_filled = false;
+    bool modifier_logged = false;
+
+    // GPU scaler state (members ordered for correct teardown: the EGL context
+    // must outlive the GL objects and slot images).
+    file_t render_fd;
+    gbm::gbm_t gbm_dev;
+    egl::display_t egl_display;
+    std::optional<egl::ctx_t> egl_ctx;
+    gl::frame_buf_t fbos;
+    std::array<scale_slot_t, 3> slots;
+    int next_slot = 0;
+    int scaler_state = 0;  // 0 = untried, 1 = ready, -1 = failed (don't retry)
+
+  public:
+    ~rkmpp_t() override {
+      for (auto &slot : slots) {
+        av_buffer_unref(&slot.ref);
+        slot.rgb = egl::rgb_t {};
+        if (slot.bo) {
+          gbm_bo_destroy(slot.bo);
+          slot.bo = nullptr;
+        }
+      }
+    }
+  };
+
+  std::unique_ptr<platf::avcodec_encode_device_t> make_avcodec_encode_device(int width, int height) {
+    auto device = std::make_unique<rkmpp_t>();
+    if (device->init(width, height)) {
+      return nullptr;
+    }
+    return device;
+  }
+}  // namespace rkmpp
diff --git a/src/platform/linux/rkmpp.h b/src/platform/linux/rkmpp.h
new file mode 100644
index 00000000..cc23d824
--- /dev/null
+++ b/src/platform/linux/rkmpp.h
@@ -0,0 +1,16 @@
+/**
+ * @file src/platform/linux/rkmpp.h
+ * @brief Declarations for Rockchip MPP (VEPU) hardware accelerated encoding.
+ *
+ * The encode device converts the captured RGB dmabuf to NV12 using the RGA
+ * 2D hardware block (librga) and feeds the result to FFmpeg's h264/hevc_rkmpp
+ * encoder as an AV_PIX_FMT_DRM_PRIME frame (zero-copy on the encode side).
+ */
+#pragma once
+
+// local includes
+#include "src/platform/common.h"
+
+namespace rkmpp {
+  std::unique_ptr<platf::avcodec_encode_device_t> make_avcodec_encode_device(int width, int height);
+}  // namespace rkmpp
diff --git a/src/platform/linux/wayland.cpp b/src/platform/linux/wayland.cpp
index ee3f2c3e..f3eb63cf 100644
--- a/src/platform/linux/wayland.cpp
+++ b/src/platform/linux/wayland.cpp
@@ -292,6 +292,96 @@ namespace wl {
     }
   }
 
+  // Destroy the persistent capture buffer ring
+  void dmabuf_t::destroy_ring() {
+    for (auto &slot : ring) {
+      if (slot.wl_buffer) {
+        wl_buffer_destroy(slot.wl_buffer);
+        slot.wl_buffer = nullptr;
+      }
+
+      if (slot.fd >= 0) {
+        close(slot.fd);
+        slot.fd = -1;
+      }
+
+      if (slot.bo) {
+        gbm_bo_destroy(slot.bo);
+        slot.bo = nullptr;
+      }
+    }
+
+    ring_next = 0;
+    ring_width = ring_height = ring_format = 0;
+  }
+
+  // Allocate the persistent capture buffer ring for the current output size
+  bool dmabuf_t::init_ring() {
+    for (auto &slot : ring) {
+      // LINEAR: the VEPU cannot read framebuffer compression formats.
