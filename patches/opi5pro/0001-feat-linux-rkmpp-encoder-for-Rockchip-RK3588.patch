 cmake/prep/options.cmake              |   2 +
 src/platform/common.h                 |   1 +
 src/platform/linux/kmsgrab.cpp        |  10 +-
 src/platform/linux/rkmpp.cpp          | 418 ++++++++++++++++++++++++++
 src/platform/linux/rkmpp.h            |  16 +
 src/platform/linux/wayland.cpp        |  97 ++++++
 src/platform/linux/wayland.h          |  25 ++
 src/platform/linux/wlgrab.cpp         |  19 +-
 src/video.cpp                         |  73 +++++
 10 files changed, 675 insertions(+), 2 deletions(-)
 create mode 100644 src/platform/linux/rkmpp.cpp
 create mode 100644 src/platform/linux/rkmpp.h

