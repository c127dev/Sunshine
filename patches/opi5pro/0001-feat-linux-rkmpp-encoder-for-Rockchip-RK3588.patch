+++ b/cmake/compile_definitions/linux.cmake
@@ -124,6 +124,22 @@ if(LIBVA_FOUND)
             "${CMAKE_SOURCE_DIR}/src/platform/linux/vaapi.cpp")
 endif()
 
+# rkmpp (Rockchip RK3588 VEPU hardware encoder)
+if(${SUNSHINE_ENABLE_RKMPP})
+    pkg_check_modules(RKMPP rockchip_mpp)
+    pkg_check_modules(RGA librga)
+    if(RKMPP_FOUND AND RGA_FOUND)
+        add_compile_definitions(SUNSHINE_BUILD_RKMPP)
+        include_directories(SYSTEM ${RKMPP_INCLUDE_DIRS} ${RGA_INCLUDE_DIRS})
+        list(APPEND PLATFORM_LIBRARIES ${RKMPP_LIBRARIES} ${RGA_LIBRARIES})
+        list(APPEND PLATFORM_TARGET_FILES
+                "${CMAKE_SOURCE_DIR}/src/platform/linux/rkmpp.h"
+                "${CMAKE_SOURCE_DIR}/src/platform/linux/rkmpp.cpp")
+    else()
+        message(WARNING "SUNSHINE_ENABLE_RKMPP set but rockchip_mpp/librga not found via pkg-config")
+    endif()
+endif()
+
 # vulkan video encoding (via FFmpeg)
 if(${SUNSHINE_ENABLE_VULKAN})
     if(NOT SUNSHINE_SYSTEM_VULKAN_HEADERS)
