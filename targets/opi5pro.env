# Orange Pi 5 Pro (RK3588S): rkmpp hardware encoder.
# patches/opi5pro was validated on this commit only; the encoder conflicts with
# the Wayland DMA-BUF capture rewrite that followed (#5132, #5699).
SOURCE_REF=8975ed14da07aeb5823c992a8d55b2e16ada9464
PATCH_DIR=patches/opi5pro
# Contains games-on-whales/inputtino#47 (MT slot reuse fix).
SUBMODULE_PINS="third-party/inputtino=6dba8f91aa21eaaeb8f6e2fe4e458bffa74f10a6"
CC=gcc
CXX=g++
TUNE="-mcpu=cortex-a76.cortex-a55"
# FFmpeg from nyanmisaka/ffmpeg-rockchip with rkmpp/rkrga.
FFMPEG=rockchip
