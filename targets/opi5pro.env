# Orange Pi 5 Pro (RK3588S): rkmpp hardware encoder.
PATCH_DIRS="patches/common patches/opi5pro"
CC=gcc-14
CXX=g++-14
TUNE="-mcpu=cortex-a76.cortex-a55"
RKMPP=ON
# FFmpeg from nyanmisaka/ffmpeg-rockchip with rkmpp/rkrga.
FFMPEG=rockchip
FFMPEG_CONFIGURE="--enable-version3 --enable-libdrm --enable-rkmpp --enable-rkrga --enable-encoder=h264_rkmpp,hevc_rkmpp,mjpeg_rkmpp"
